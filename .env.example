IMAP_HOST=mail.example.net
IMAP_PORT=993
IMAP_TLS=implicit
IMAP_USERNAME=you@example.net
IMAP_PASSWORD=replace-me

SMTP_HOST=mail.example.net
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@example.net
SMTP_PASSWORD=replace-me

MAIL_ADDRESS=you@example.net
MAIL_DISPLAY_NAME="Your Name"
MAIL_VERIFY_TLS=true
# MAIL_CA_FILE=/path/to/your-ca.pem

# Local runtime defaults. Docker Compose sets its bind host and port itself.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Generate this with: openssl rand -hex 32
MCP_AUTH_TOKEN=
MCP_READ_ONLY=true
# MCP_ALLOWED_HOSTS=postbox:8000

APPEND_SENT=true
ALLOW_PERMANENT_DELETE=false
# SENT_FOLDER=Sent
# DRAFTS_FOLDER=Drafts
# TRASH_FOLDER=Trash
# ARCHIVE_FOLDER=Archive
